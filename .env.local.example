# Copy this file to .env.local for local testing (never commit the real .env.local).
# In production, set these in Vercel: Project → Settings → Environment Variables.

# Required — your free Google AI Studio key.
GEMINI_API_KEY=your_key_here

# Optional but recommended — your real deployed URL, once you have it.
# Used for correct SEO metadata, Open Graph tags, and the sitemap.
# Not secret — safe to set as a plain (non-sensitive) environment variable.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
